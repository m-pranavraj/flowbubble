<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The companion's face. Everything sits inside the 66dp adaptive safe zone so no
         launcher mask can clip the eyes, and the head is large enough to read at 32dp. -->

    <!-- Antenna: a stem rising from the head with a lit tip. -->
    <path
        android:strokeColor="#FFB9A7FF"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M54,31 Q53,27 56,24.5" />
    <path
        android:fillColor="#FFFF7A96"
        android:pathData="M54.4,24.5 A2.6,2.6 0 1 0 59.6,24.5 A2.6,2.6 0 1 0 54.4,24.5 Z" />

    <!-- Head. -->
    <path android:pathData="M27,56 A27,27 0 1 0 81,56 A27,27 0 1 0 27,56 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="33"
                android:startY="33"
                android:endX="77"
                android:endY="80">
                <item android:offset="0" android:color="#FFDCCFFF" />
                <item android:offset="0.46" android:color="#FFB9A7FF" />
                <item android:offset="1" android:color="#FF7C4DDD" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Blush, so the face reads as a baby rather than a robot. -->
    <path
        android:fillColor="#59FF2D55"
        android:pathData="M30.4,64 A4.6,2.6 0 1 0 39.6,64 A4.6,2.6 0 1 0 30.4,64 Z" />
    <path
        android:fillColor="#59FF2D55"
        android:pathData="M68.4,64 A4.6,2.6 0 1 0 77.6,64 A4.6,2.6 0 1 0 68.4,64 Z" />

    <!-- Eyes. -->
    <path
        android:fillColor="#FF050308"
        android:pathData="M38.2,53 A5.8,7.4 0 1 0 49.8,53 A5.8,7.4 0 1 0 38.2,53 Z" />
    <path
        android:fillColor="#FF050308"
        android:pathData="M58.2,53 A5.8,7.4 0 1 0 69.8,53 A5.8,7.4 0 1 0 58.2,53 Z" />

    <!-- Specular highlights. -->
    <path
        android:fillColor="#FFF2EEFB"
        android:pathData="M43.9,50 A2.1,2.1 0 1 0 48.1,50 A2.1,2.1 0 1 0 43.9,50 Z" />
    <path
        android:fillColor="#FFF2EEFB"
        android:pathData="M63.9,50 A2.1,2.1 0 1 0 68.1,50 A2.1,2.1 0 1 0 63.9,50 Z" />

    <!-- Smile. -->
    <path
        android:strokeColor="#FF050308"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:pathData="M46,66 Q54,73 62,66" />
</vector>
